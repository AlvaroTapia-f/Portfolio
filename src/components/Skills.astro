---
import HTML from "./icons/HTML.astro";
import CSS from "./icons/CSS.astro";
import JavaScript from "./icons/JavaScript.astro";
import Java from "./icons/Java.astro";
import Spring from "./icons/Spring.astro";
import Sql from "./icons/Sql.astro";
import ReactIcon from "./icons/React.astro";
import TypeScriptIcon from "./icons/TypeScript.astro";
import NodejsIcon from "./icons/NodeJs.astro";
import ExpressIcon from "./icons/ExpressJs.astro";
import MongoDBIcon from "./icons/MongoDB.astro";
import GitIcon from "./icons/Git.astro";
import VSCodeIcon from "./icons/VSCode.astro";
import PostmanIcon from "./icons/Postman.astro";
import SwaggerIcon from "./icons/Swagger.astro";
import AstroIcon from "./icons/AstroIcon.astro";

const groups = [
  {
    label: "IA y agentes",
    accent: "text-orange-300",
    wide: true,
    items: [
      { name: "OpenCode" },
      { name: "Pi" },
      { name: "Antigravity" },
      { name: "Hermes" },
      { name: "SDD" },
      { name: "ODD" },
      { name: "Orquestador + subagentes" },
      { name: "Slices verificables" },
      { name: "Gestión de contexto" },
      { name: "Costo por feature" },
      { name: "TDD" },
      { name: "Verificación independiente" },
      { name: "Guardrails" },
    ],
  },
  {
    label: "Lenguajes",
    accent: "text-cyan-200",
    items: [
      { name: "TypeScript", icon: TypeScriptIcon },
      { name: "JavaScript", icon: JavaScript },
      { name: "Java", icon: Java },
      { name: "Python" },
      { name: "SQL", icon: Sql },
    ],
  },
  {
    label: "Backend y APIs",
    accent: "text-cyan-200",
    items: [
      { name: "Node.js", icon: NodejsIcon },
      { name: "Express", icon: ExpressIcon },
      { name: "Spring Boot", icon: Spring },
      { name: "APIs REST" },
      { name: "Postman", icon: PostmanIcon },
      { name: "Swagger UI", icon: SwaggerIcon },
    ],
  },
  {
    label: "Frontend",
    accent: "text-cyan-200",
    items: [
      { name: "Svelte" },
      { name: "React", icon: ReactIcon },
      { name: "Astro", icon: AstroIcon },
      { name: "HTML", icon: HTML },
      { name: "CSS", icon: CSS },
      { name: "Tailwind CSS" },
    ],
  },
  {
    label: "Datos",
    accent: "text-blue-300",
    items: [
      { name: "PostgreSQL" },
      { name: "Supabase" },
      { name: "MongoDB", icon: MongoDBIcon },
      { name: "Row Level Security" },
      { name: "RPC" },
      { name: "Consultas SQL" },
    ],
  },
  {
    label: "DevOps y herramientas",
    accent: "text-blue-300",
    wide: true,
    items: [
      { name: "Git", icon: GitIcon },
      { name: "GitHub Actions" },
      { name: "Docker" },
      { name: "Docker Compose" },
      { name: "Linux (Arch)" },
      { name: "Vercel" },
      { name: "Vitest" },
      { name: "Playwright" },
      { name: "VS Code", icon: VSCodeIcon },
    ],
  },
];
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
  {
    groups.map((group) => (
      <div
        class={`bg-[#18192a] border border-[#a18cd1]/25 rounded-2xl p-5 shadow-xl transition hover:border-[#a18cd1]/60 ${
          group.wide ? "md:col-span-2" : ""
        }`}
      >
        <h3 class={`mb-4 text-lg font-bold tracking-wide ${group.accent}`}>
          {group.label}
        </h3>
        <ul class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="flex items-center gap-1.5 rounded-lg border border-[#a18cd1]/25 bg-[#27034b]/40 px-2.5 py-1.5 text-xs text-[#f1e7ff]/90 transition hover:scale-105 hover:border-[#a18cd1]/60">
              {item.icon && <item.icon class="size-4" />}
              <span>{item.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
