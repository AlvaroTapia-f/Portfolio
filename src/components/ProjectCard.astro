---
import GitHubIcon from "./icons/GitHubIcon.astro";
import LaptopIcon from "./icons/LaptopIcon.astro";
import AgyBridgeDiagram from "./AgyBridgeDiagram.astro";

const {
  title,
  subtitle,
  description,
  bullets = [],
  metrics = [],
  tags = [],
  github,
  demo,
  note,
  images = [],
  diagram = false,
  flip = false,
} = Astro.props;

const [cover, ...gallery] = images;
const linkClass =
  "flex gap-2 items-center text-xs md:text-sm bg-white/50 border border-gray-500/60 hover:bg-gray-100 dark:bg-gray-800/70 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 rounded-lg px-4 py-2 transition";
---

<article
  class="group grid items-start gap-6 border-b border-[#a18cd1]/15 py-8 last:border-0 md:grid-cols-2 md:gap-8"
>
  <div class={`flex flex-col gap-4 ${flip ? "md:order-2" : ""}`}>
    <div>
      <p
        class="text-[0.65rem] uppercase tracking-[0.18em] text-[#7c3aed] dark:text-[#a18cd1]"
      >
        {subtitle}
      </p>
      <h3 class="pt-1 text-2xl font-bold tracking-tight">{title}</h3>
    </div>

    <p class="text-sm leading-relaxed">{description}</p>

    <ul class="flex flex-col gap-2 text-sm leading-relaxed">
      {
        bullets.map((bullet) => (
          <li class="flex gap-2">
            <span class="text-[#8f5cff] dark:text-[#a18cd1]">▸</span>
            <span class="text-[#1a0e2e]/85 dark:text-[#f1e7ff]/85">
              {bullet}
            </span>
          </li>
        ))
      }
    </ul>

    {
      metrics.length > 0 && (
        <dl class="grid grid-cols-3 gap-2 border-y border-[#a18cd1]/20 py-3">
          {metrics.map((metric) => (
            <div class="flex flex-col">
              <dt class="order-2 text-[0.6rem] uppercase leading-tight tracking-wide text-[#1a0e2e]/55 dark:text-[#f1e7ff]/55">
                {metric.label}
              </dt>
              <dd class="order-1 text-xl font-bold text-[#7c3aed] dark:text-cyan-200">
                {metric.value}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    <ul class="flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <li class="rounded-full bg-purple-100 text-purple-800/80 text-[0.7rem] font-medium px-2 py-0.5 dark:bg-purple-900/70 dark:text-purple-300">
            {tag}
          </li>
        ))
      }
    </ul>

    <div class="flex flex-wrap items-center gap-2">
      {
        github && (
          <a href={github} target="_blank" rel="noreferrer" class={linkClass}>
            <GitHubIcon class="size-4" />
            Código
          </a>
        )
      }
      {
        demo && (
          <a href={demo} target="_blank" rel="noreferrer" class={linkClass}>
            <LaptopIcon class="size-4" />
            Ver en producción
          </a>
        )
      }
      {
        note && (
          <span class="text-[0.7rem] text-[#1a0e2e]/55 dark:text-[#f1e7ff]/55">
            {note}
          </span>
        )
      }
    </div>
  </div>

  <div class={`w-full ${flip ? "md:order-1" : ""}`}>
    {
      diagram ? (
        <AgyBridgeDiagram />
      ) : (
        <div class="flex flex-col gap-2">
          <a href={demo || cover} target="_blank" rel="noreferrer">
            <img
              src={cover}
              alt={`Captura de ${title}`}
              loading="lazy"
              class="aspect-[4/3] w-full rounded-xl border border-[#27034b]/60 object-cover object-top shadow-xl transition duration-500 group-hover:-translate-y-1 group-hover:shadow-2xl"
            />
          </a>
          {gallery.length > 0 && (
            <div class="grid grid-cols-3 gap-2">
              {gallery.map((image) => (
                <a
                  href={demo || image}
                  target="_blank"
                  rel="noreferrer"
                  class="overflow-hidden rounded-lg border border-[#27034b]/60"
                >
                  <img
                    src={image}
                    alt={`Captura de ${title}`}
                    loading="lazy"
                    class="h-20 w-full object-cover object-top opacity-90 transition hover:scale-105 hover:opacity-100 md:h-24"
                  />
                </a>
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
</article>
